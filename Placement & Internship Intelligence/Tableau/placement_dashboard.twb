<?xml version='1.0' encoding='utf-8' ?>
<workbook version='18.1' xmlns:user='http://www.tableausoftware.com/xml/user'>
  <preferences>
    <preference name='ui.encoding.shelf.height' value='24' />
    <preference name='ui.shelf.height' value='26' />
  </preferences>
  <datasources>
    <datasource caption='placement_data' inline='true' name='federated.placement_data' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='placement_data' name='textscan.placement_data'>
            <connection class='textscan' directory='../Data' filename='placement_data.csv' />
          </named-connection>
        </named-connections>
        <relation connection='textscan.placement_data' name='placement_data.csv' table='[placement_data#csv]' type='table'>
          <columns character-set='UTF-8' header='yes' locale='en_US' separator=','>
            <column datatype='string' name='Student_ID' ordinal='0' />
            <column datatype='string' name='Department' ordinal='1' />
            <column datatype='integer' name='Graduation_Year' ordinal='2' />
            <column datatype='real' name='CGPA' ordinal='3' />
            <column datatype='string' name='Internship' ordinal='4' />
            <column datatype='string' name='Placement_Status' ordinal='5' />
            <column datatype='string' name='Company' ordinal='6' />
            <column datatype='string' name='Job_Role' ordinal='7' />
            <column datatype='real' name='Salary_LPA' ordinal='8' />
            <column datatype='string' name='Location' ordinal='9' />
          </columns>
        </relation>
      </connection>
      <aliases enabled='yes' />
      <column caption='Student ID' datatype='string' name='[Student_ID]' role='dimension' type='nominal' />
      <column caption='Department' datatype='string' name='[Department]' role='dimension' type='nominal' />
      <column caption='Graduation Year' datatype='integer' name='[Graduation_Year]' role='dimension' type='quantitative' />
      <column caption='CGPA' datatype='real' name='[CGPA]' role='measure' type='quantitative' />
      <column caption='Internship' datatype='string' name='[Internship]' role='dimension' type='nominal' />
      <column caption='Placement Status' datatype='string' name='[Placement_Status]' role='dimension' type='nominal' />
      <column caption='Company' datatype='string' name='[Company]' role='dimension' type='nominal' />
      <column caption='Job Role' datatype='string' name='[Job_Role]' role='dimension' type='nominal' />
      <column caption='Salary LPA' datatype='real' name='[Salary_LPA]' role='measure' type='quantitative' />
      <column caption='Location' datatype='string' name='[Location]' role='dimension' type='nominal' />

      <column caption='Is Placed' datatype='integer' name='[Calculation_IsPlaced]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IIF([Placement_Status] = &quot;Placed&quot;, 1, 0)' />
      </column>
      <column caption='Placement Rate' datatype='real' name='[Calculation_PlacementRate]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_IsPlaced]) / COUNT([Student_ID])' />
      </column>
    </datasource>
  </datasources>

  <worksheets>
    <!-- KPI 1: Total Students -->
    <worksheet name='KPI_Total_Students'>
      <table>
        <view>
          <datasources><datasource name='federated.placement_data' /></datasources>
          <datasource-dependencies datasource='federated.placement_data'>
            <column name='[Student_ID]' role='dimension' type='nominal' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <panes>
          <pane>
            <view><breakdown value='auto' /></view>
            <mark class='Text' />
            <encodings><text column='[federated.placement_data].[cnt:Student_ID:qk]' /></encodings>
          </pane>
        </panes>
        <rows />
        <cols />
      </table>
    </worksheet>

    <!-- KPI 2: Placed Students -->
    <worksheet name='KPI_Placed_Students'>
      <table>
        <view>
          <datasources><datasource name='federated.placement_data' /></datasources>
          <datasource-dependencies datasource='federated.placement_data'>
            <column name='[Calculation_IsPlaced]' role='measure' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <panes>
          <pane>
            <view><breakdown value='auto' /></view>
            <mark class='Text' />
            <encodings><text column='[federated.placement_data].[sum:Calculation_IsPlaced:qk]' /></encodings>
          </pane>
        </panes>
        <rows />
        <cols />
      </table>
    </worksheet>

    <!-- KPI 3: Placement Rate -->
    <worksheet name='KPI_Placement_Rate'>
      <table>
        <view>
          <datasources><datasource name='federated.placement_data' /></datasources>
          <datasource-dependencies datasource='federated.placement_data'>
            <column name='[Calculation_PlacementRate]' role='measure' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <panes>
          <pane>
            <view><breakdown value='auto' /></view>
            <mark class='Text' />
            <encodings><text column='[federated.placement_data].[usr:Calculation_PlacementRate:qk]' /></encodings>
          </pane>
        </panes>
        <rows />
        <cols />
      </table>
    </worksheet>

    <!-- KPI 4: Average Salary -->
    <worksheet name='KPI_Avg_Salary'>
      <table>
        <view>
          <datasources><datasource name='federated.placement_data' /></datasources>
          <datasource-dependencies datasource='federated.placement_data'>
            <column name='[Salary_LPA]' role='measure' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <panes>
          <pane>
            <view><breakdown value='auto' /></view>
            <mark class='Text' />
            <encodings><text column='[federated.placement_data].[avg:Salary_LPA:qk]' /></encodings>
          </pane>
        </panes>
        <rows />
        <cols />
      </table>
    </worksheet>

    <!-- Chart 1: Placement Rate by Department -->
    <worksheet name='Chart_Placement_Rate_By_Dept'>
      <table>
        <view>
          <datasources><datasource name='federated.placement_data' /></datasources>
          <datasource-dependencies datasource='federated.placement_data'>
            <column name='[Department]' role='dimension' type='nominal' />
            <column name='[Calculation_PlacementRate]' role='measure' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <panes>
          <pane>
            <view><breakdown value='auto' /></view>
            <mark class='Bar' />
            <encodings>
              <color column='[federated.placement_data].[usr:Calculation_PlacementRate:qk]' />
            </encodings>
          </pane>
        </panes>
        <rows>[federated.placement_data].[Department]</rows>
        <cols>[federated.placement_data].[usr:Calculation_PlacementRate:qk]</cols>
      </table>
    </worksheet>

    <!-- Chart 2: Average Salary by Department -->
    <worksheet name='Chart_Avg_Salary_By_Dept'>
      <table>
        <view>
          <datasources><datasource name='federated.placement_data' /></datasources>
          <datasource-dependencies datasource='federated.placement_data'>
            <column name='[Department]' role='dimension' type='nominal' />
            <column name='[Salary_LPA]' role='measure' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <panes>
          <pane>
            <view><breakdown value='auto' /></view>
            <mark class='Bar' />
          </pane>
        </panes>
        <rows>[federated.placement_data].[Department]</rows>
        <cols>[federated.placement_data].[avg:Salary_LPA:qk]</cols>
      </table>
    </worksheet>

    <!-- Chart 3: Placement Trend by Graduation Year -->
    <worksheet name='Chart_Placement_Trend_By_Year'>
      <table>
        <view>
          <datasources><datasource name='federated.placement_data' /></datasources>
          <datasource-dependencies datasource='federated.placement_data'>
            <column name='[Graduation_Year]' role='dimension' type='quantitative' />
            <column name='[Calculation_PlacementRate]' role='measure' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <panes>
          <pane>
            <view><breakdown value='auto' /></view>
            <mark class='Line' />
          </pane>
        </panes>
        <rows>[federated.placement_data].[usr:Calculation_PlacementRate:qk]</rows>
        <cols>[federated.placement_data].[Graduation_Year]</cols>
      </table>
    </worksheet>
  </worksheets>

  <dashboards>
    <dashboard name='Campus_Placement_Intelligence'>
      <style />
      <size maxheight='800' maxwidth='1200' minheight='800' minwidth='1200' />
      <zones>
        <zone h='100000' id='1' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='98000' id='2' param='vert' type-v2='layout-flow' w='98000' x='1000' y='1000'>
            <!-- Title -->
            <zone h='8000' id='3' type-v2='text' w='98000' x='1000' y='1000'>
              <formatted-text>
                <run bold='true' fontcolor='#1e293b' fontname='Calibri' fontsize='18'>Campus Placement &amp; Internship Intelligence Dashboard</run>
              </formatted-text>
            </zone>
            
            <!-- Filters Zone (Department & Graduation Year) -->
            <zone h='6000' id='4' param='horz' type-v2='layout-flow' w='98000' x='1000' y='9000'>
              <zone h='6000' id='5' name='Chart_Placement_Rate_By_Dept' param='[federated.placement_data].[Department]' type-v2='filter' w='48000' x='1000' y='9000' />
              <zone h='6000' id='6' name='Chart_Placement_Rate_By_Dept' param='[federated.placement_data].[Graduation_Year]' type-v2='filter' w='48000' x='50000' y='9000' />
            </zone>

            <!-- KPI Row (4 Cards) -->
            <zone h='16000' id='7' param='horz' type-v2='layout-flow' w='98000' x='1000' y='15000'>
              <zone h='16000' id='8' name='KPI_Total_Students' type-v2='widget' w='24000' x='1000' y='15000' />
              <zone h='16000' id='9' name='KPI_Placed_Students' type-v2='widget' w='24000' x='25000' y='15000' />
              <zone h='16000' id='10' name='KPI_Placement_Rate' type-v2='widget' w='24000' x='50000' y='15000' />
              <zone h='16000' id='11' name='KPI_Avg_Salary' type-v2='widget' w='24000' x='75000' y='15000' />
            </zone>

            <!-- Charts Row 1 (Placement Rate by Dept & Avg Salary by Dept) -->
            <zone h='34000' id='12' param='horz' type-v2='layout-flow' w='98000' x='1000' y='32000'>
              <zone h='34000' id='13' name='Chart_Placement_Rate_By_Dept' type-v2='widget' w='48000' x='1000' y='32000' />
              <zone h='34000' id='14' name='Chart_Avg_Salary_By_Dept' type-v2='widget' w='48000' x='50000' y='32000' />
            </zone>

            <!-- Charts Row 2 (Placement Trend by Year) -->
            <zone h='34000' id='15' param='horz' type-v2='layout-flow' w='98000' x='1000' y='67000'>
              <zone h='34000' id='16' name='Chart_Placement_Trend_By_Year' type-v2='widget' w='98000' x='1000' y='67000' />
            </zone>
          </zone>
        </zone>
      </zones>
    </dashboard>
  </dashboards>

  <windows>
    <window class='dashboard' name='Campus_Placement_Intelligence'>
      <viewpoints />
      <active id='-1' />
    </window>
  </windows>
</workbook>